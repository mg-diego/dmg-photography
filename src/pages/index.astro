---
import Layout from '../layouts/Layout.astro';
import heroImg from '../assets/urban/night-skyline--tokyo_36977302436_l.jpg';
import Card from '../components/Card.astro';

// Obtenemos todas las imágenes de forma dinámica
const images = import.meta.glob<{ default: { src: string } }>('../assets/**/*.{jpeg,jpg,png}', { eager: true });

// Convertimos el objeto en un array mapeando su categoría
const imageList = Object.keys(images).map(path => {
	const src = images[path].default.src;
	let category = 'otros';
	if (path.includes('/music/')) category = 'musica';
	else if (path.includes('/urban/')) category = 'urbano';
	else if (path.includes('/nature/')) category = 'naturaleza';
	return { src, category };
});

// Seleccionamos imágenes para el grid
const galleryImages = imageList.slice(0, 36);
---

<Layout title="Inicio">
	<!-- Hero Section -->
	<section class="relative h-screen flex items-center justify-center">
		<!-- Background Image -->
		<div class="fixed inset-0 z-0 h-screen w-full">
			<img src={heroImg.src} alt="Tokyo Night Skyline" class="w-full h-full object-cover object-center scale-105 animate-[pulse_30s_ease-in-out_infinite_alternate] opacity-60" />
			<div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-dark/50 to-dark"></div>
		</div>

		<!-- Content -->
		<div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-16">
			<h1 class="text-5xl md:text-7xl lg:text-8xl font-serif text-white mb-6 tracking-tight leading-tight opacity-0 animate-[fadeInUp_1s_ease-out_forwards]">
				Capturing the<br/><span class="italic text-gray-300">Unseen</span>
			</h1>
			<p class="text-sm md:text-base text-gray-400 uppercase tracking-[0.3em] mb-12 opacity-0 animate-[fadeInUp_1s_ease-out_0.3s_forwards] font-light">
				DMG Photography Portfolio
			</p>
			<a href="#galeria" class="opacity-0 animate-[fadeInUp_1s_ease-out_0.6s_forwards] inline-block border border-white/20 text-white px-8 py-3 text-xs uppercase tracking-[0.2em] hover:bg-white hover:text-dark transition-all duration-500">
				Explorar Galería
			</a>
		</div>
	</section>

	<!-- Galería Section -->
	<section id="galeria" class="relative z-10 bg-dark pt-32 pb-16 px-6 shadow-[0_-20px_50px_rgba(10,10,10,1)]">
		<div class="max-w-7xl mx-auto min-h-screen">
			<header class="mb-12 text-center">
				<h2 class="text-4xl md:text-5xl font-serif text-white mb-4 tracking-wide">Galería</h2>
				<p class="text-sm text-gray-400 uppercase tracking-[0.2em] font-light">Una selección de mis mejores capturas</p>
			</header>
			
			<!-- Filtros -->
			<div class="flex flex-wrap justify-center gap-4 mb-16">
				<button class="filter-btn active text-xs uppercase tracking-[0.2em] px-4 py-2 border-b border-white text-white transition-colors duration-300" data-filter="all">Todos</button>
				<button class="filter-btn text-xs uppercase tracking-[0.2em] px-4 py-2 border-b border-transparent text-gray-500 hover:text-white transition-colors duration-300" data-filter="musica">Música</button>
				<button class="filter-btn text-xs uppercase tracking-[0.2em] px-4 py-2 border-b border-transparent text-gray-500 hover:text-white transition-colors duration-300" data-filter="urbano">Urbano</button>
				<button class="filter-btn text-xs uppercase tracking-[0.2em] px-4 py-2 border-b border-transparent text-gray-500 hover:text-white transition-colors duration-300" data-filter="naturaleza">Naturaleza</button>
			</div>

			<!-- Grid de Proyectos -->
			<div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6" id="gallery-container">
				{galleryImages.map((img, index) => {
					const ratios = ["aspect-[3/4]", "aspect-[4/5]", "aspect-[2/3]", "aspect-square"];
					const ratio = ratios[index % ratios.length];
					const title = 'Captura #' + (index + 1);
					
					const catLabel = img.category === 'musica' ? 'Música' : 
									 img.category === 'urbano' ? 'Urbano' : 
									 img.category === 'naturaleza' ? 'Naturaleza' : 'Fotografía';

					return (
						<div class="break-inside-avoid gallery-wrapper">
							<Card 
								title={title}
								description={catLabel}
								image={img.src}
								alt={title}
								category={img.category}
								aspectRatio={ratio}
							/>
						</div>
					);
				})}
			</div>
		</div>
	</section>

	<!-- Lightbox / Modal -->
	<div id="lightbox" class="fixed inset-0 z-[100] bg-[#0a0a0a]/95 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-500 flex items-center justify-center p-4 select-none">
		<button id="lightbox-close" class="absolute top-6 right-6 text-white/50 hover:text-white transition-colors p-2 z-10" aria-label="Cerrar">
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
		</button>
		
		<button id="lightbox-prev" class="absolute left-6 text-white/50 hover:text-white transition-colors p-2 z-10 hidden sm:block focus:outline-none" aria-label="Anterior">
			<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
		</button>

		<img id="lightbox-img" src="" alt="Imagen ampliada" class="max-h-full max-w-full object-contain scale-95 transition-transform duration-500 shadow-2xl" />

		<button id="lightbox-next" class="absolute right-6 text-white/50 hover:text-white transition-colors p-2 z-10 hidden sm:block focus:outline-none" aria-label="Siguiente">
			<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
		</button>
	</div>
</Layout>

<style>
	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}
	
	.gallery-wrapper {
		transition: opacity 0.5s ease, transform 0.5s ease;
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const filterBtns = document.querySelectorAll('.filter-btn');
		const galleryWrappers = document.querySelectorAll('.gallery-wrapper');
		const lightbox = document.getElementById('lightbox');
		const lightboxImg = document.getElementById('lightbox-img');
		const lightboxClose = document.getElementById('lightbox-close');
		const lightboxPrev = document.getElementById('lightbox-prev');
		const lightboxNext = document.getElementById('lightbox-next');

		if (!lightbox) return;

		let visibleImages: string[] = [];
		let currentImageIndex = -1;

		const updateVisibleImages = () => {
			visibleImages = [];
			const items = document.querySelectorAll('.gallery-item');
			items.forEach(item => {
				const wrapper = item.closest('.gallery-wrapper');
				if (wrapper && (wrapper as HTMLElement).style.display !== 'none') {
					const src = item.getAttribute('data-image');
					if (src) visibleImages.push(src);
				}
			});
		};

		// --- Lógica de Filtrado ---
		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				filterBtns.forEach(b => {
					b.classList.remove('border-white', 'text-white');
					b.classList.add('border-transparent', 'text-gray-500');
				});
				btn.classList.remove('border-transparent', 'text-gray-500');
				btn.classList.add('border-white', 'text-white');

				const filter = btn.getAttribute('data-filter');

				galleryWrappers.forEach(wrapper => {
					if (!(wrapper instanceof HTMLElement)) return;
					const item = wrapper.querySelector('.gallery-item');
					if (!item) return;
					
					const category = item.getAttribute('data-category');
					
					if (filter === 'all' || filter === category) {
						wrapper.style.display = 'block';
						setTimeout(() => {
							wrapper.style.opacity = '1';
							wrapper.style.transform = 'scale(1)';
						}, 50);
					} else {
						wrapper.style.opacity = '0';
						wrapper.style.transform = 'scale(0.95)';
						setTimeout(() => {
							wrapper.style.display = 'none';
							updateVisibleImages(); // Update after animation
						}, 500);
					}
				});
				
				if (filter === 'all') {
					setTimeout(updateVisibleImages, 100);
				}
			});
		});

		// Initial update
		updateVisibleImages();

		// --- Lógica del Lightbox ---
		const showImage = (index: number) => {
			if (!lightboxImg || !lightbox || !(lightboxImg instanceof HTMLImageElement)) return;
			if (visibleImages.length === 0) return;
			
			currentImageIndex = (index + visibleImages.length) % visibleImages.length;
			lightboxImg.src = visibleImages[currentImageIndex];
		};

		const nextImage = () => showImage(currentImageIndex + 1);
		const prevImage = () => showImage(currentImageIndex - 1);

		const openLightbox = (src: string) => {
			if (!lightboxImg || !lightbox || !(lightboxImg instanceof HTMLImageElement)) return;
			
			updateVisibleImages();
			currentImageIndex = visibleImages.indexOf(src);
			
			if (currentImageIndex === -1) currentImageIndex = 0;

			lightboxImg.src = src;
			lightbox.classList.remove('opacity-0', 'pointer-events-none');
			lightbox.classList.add('opacity-100', 'pointer-events-auto');
			setTimeout(() => {
				lightboxImg.classList.remove('scale-95');
				lightboxImg.classList.add('scale-100');
			}, 50);
			document.body.style.overflow = 'hidden';
		};

		const closeLightbox = () => {
			if (!lightboxImg || !lightbox || !(lightboxImg instanceof HTMLImageElement)) return;
			lightbox.classList.remove('opacity-100', 'pointer-events-auto');
			lightbox.classList.add('opacity-0', 'pointer-events-none');
			lightboxImg.classList.remove('scale-100');
			lightboxImg.classList.add('scale-95');
			document.body.style.overflow = '';
		};

		const galleryItems = document.querySelectorAll('.gallery-item');
		galleryItems.forEach(item => {
			item.addEventListener('click', (e) => {
				e.preventDefault();
				const src = item.getAttribute('data-image');
				if (src) openLightbox(src);
			});
		});

		if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
		if (lightboxPrev) lightboxPrev.addEventListener('click', (e) => { e.stopPropagation(); prevImage(); });
		if (lightboxNext) lightboxNext.addEventListener('click', (e) => { e.stopPropagation(); nextImage(); });
		
		if (lightbox) {
			lightbox.addEventListener('click', (e) => {
				// Cierra si el clic es fuera de la imagen o en botones
				if (e.target === lightbox || e.target === lightboxImg) {
					closeLightbox();
				}
			});
			
			// Mouse wheel navigation
			lightbox.addEventListener('wheel', (e) => {
				if (e.deltaY > 0) {
					nextImage();
				} else if (e.deltaY < 0) {
					prevImage();
				}
			}, { passive: true });
		}

		document.addEventListener('keydown', (e) => {
			if (lightbox && lightbox.classList.contains('opacity-100')) {
				if (e.key === 'Escape') closeLightbox();
				if (e.key === 'ArrowRight') nextImage();
				if (e.key === 'ArrowLeft') prevImage();
			}
		});
	});
</script>
