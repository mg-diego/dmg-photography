---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '../global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio de Diego - DMG Photography" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | DMG Photography</title>
	</head>
	<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col font-sans">
		<Header />
		<main class="flex-grow max-w-5xl mx-auto px-4 py-8 w-full">
			<slot />
		</main>
		<Footer />
	</body>
</html>
