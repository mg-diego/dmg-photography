---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '../global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio de Diego - DMG Photography" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | DMG Photography</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
		
		<ViewTransitions />
	</head>
	<body class="bg-[#0a0a0a] text-gray-200 min-h-screen flex flex-col font-sans selection:bg-gray-800 selection:text-white">
		<Header />
		<main class="flex-grow w-full">
			<slot />
		</main>
		<Footer />
	</body>
</html>
